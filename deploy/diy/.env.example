PRODUCTION_SSH_KNOWN_HOSTS=replace-in-github-environment
MEDIA_STORAGE_BACKEND=qiniu
QINIU_ACCESS_KEY=managed-outside-git
QINIU_SECRET_KEY=managed-outside-git
