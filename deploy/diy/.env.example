# Copy to the server-managed .env. Never commit the real file.
DIY_POSTGRES_PASSWORD=replace-on-server
DIY_JWT_SECRET=replace-on-server
PRODUCTION_SSH_KNOWN_HOSTS=replace-in-github-environment
MEDIA_STORAGE_BACKEND=qiniu
QINIU_ACCESS_KEY=managed-outside-git
QINIU_SECRET_KEY=managed-outside-git
QINIU_BUCKET=diyhxy
QINIU_CDN_DOMAIN=https://img.hexiaoyue.com

# Optional review-only recipients; empty preserves the existing order allowlist.
WECOM_FEEDBACK_NOTIFY_USERIDS=

# Opt in only after store-manager notification acceptance.
WECOM_VISIT_FEEDBACK_NOTIFY_ENABLED=false

# Enable staff learning only after the approved migration and course import.
STAFF_LEARNING_ENABLED=false

# AI learning coach / weekly plan. Disabled unless all three are configured.
LEARNING_AI_ENABLED=false
LEARNING_AI_BASE_URL=https://api.deepseek.com
LEARNING_AI_API_KEY=
LEARNING_AI_MODEL=deepseek-flash
LEARNING_AI_TIMEOUT_SECONDS=25
LEARNING_AI_MAX_OUTPUT_TOKENS=800
LEARNING_AI_COACH_DAILY_LIMIT=30
LEARNING_AI_PLAN_DAILY_LIMIT=5

# Manager meeting recording transcription. Audio stays in Qiniu; Tencent ASR is called server-side.
MEDIA_AUDIO_MAX_SIZE_BYTES=41943040
ASR_PROVIDER=tencent
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_REGION=ap-guangzhou
TENCENT_ASR_ENGINE=16k_zh
