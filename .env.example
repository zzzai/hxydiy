# ===== 荷小悦后端环境变量模板 =====
# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，严禁入库

# 运行环境：local / test / staging / production
ENVIRONMENT=local

# 数据库：开发可用 SQLite，生产必须 PostgreSQL
# 本地开发：sqlite:///./hxy_dev.db
# 生产：postgresql+psycopg://hxy:密码@localhost:5432/hxy
DATABASE_URL=sqlite:///./hxy_dev.db

# JWT（生产环境必须更换为长随机串）
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 微信小程序（公众平台获取）=====
WX_APPID=wx97fb30aed3983c2c
WX_APPSECRET=

# ===== 微信支付 v3（商户平台获取，勿外传）=====
WXPAY_MCHID=1721910769
WXPAY_APPID=wx97fb30aed3983c2c
WXPAY_APIV3_KEY=
WXPAY_CERT_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=/etc/hxy/certs/apiclient_key.pem
WXPAY_PUBLIC_KEY_ID=
WXPAY_PUBLIC_KEY_PATH=/etc/hxy/certs/wechatpay_public_key.pem
WXPAY_NOTIFY_URL=https://api.hexiaoyue.com/api/v1/payments/notify
